FROM nciccbr/ccbr_ubuntu_22.04:v4

# Build time variables
ARG DOCKERFILE="Dockerfile"
ENV DOCKERFILE=${DOCKERFILE}
ARG BUILD_DATE="000000"
ENV BUILD_DATE=${BUILD_DATE}
ARG BUILD_TAG="000000"
ENV BUILD_TAG=${BUILD_TAG}
ARG REPONAME="000000"
ENV REPONAME=${REPONAME}
ARG IMAGENAME="000000"
ENV IMAGENAME=${IMAGENAME}
ARG BASEIMAGENAME="000000"
ENV BASEIMAGENAME=${BASEIMAGENAME}

# install R dependencies
RUN apt-get update && apt-get upgrade -y && \
    apt-get install --yes --no-install-recommends r-base && \
    Rscript -e 'install.packages(c("optparse", "XML", "truncnorm", "BiocManager"), repos="https://cloud.r-project.org")' && \
    wget -q https://cran.r-project.org/src/contrib/Archive/gsmoothr/gsmoothr_0.1.7.tar.gz -O /tmp/gsmoothr.tar.gz && \
    wget -q https://cran.r-project.org/src/contrib/Archive/Rsolnp/Rsolnp_1.16.tar.gz -O /tmp/Rsolnp.tar.gz && \
    wget -q https://cran.r-project.org/src/contrib/Archive/S7/S7_0.2.2.tar.gz -O /tmp/S7.tar.gz && \
    echo "b75ffd2a4a0f357762e02e46e355b45cc90ea637830f0a1b01f216bb4541e903  /tmp/gsmoothr.tar.gz" | sha256sum -c - && \
    echo "3142776062beb8e2b45cdbc4fe6e5446b6d33505253d79f2890fe4178d9cf670  /tmp/Rsolnp.tar.gz" | sha256sum -c - && \
    echo "6f33245dde05b74265b1c4d379e034bc3a8923d41e7b52e6e75a75ce97d42af7  /tmp/S7.tar.gz" | sha256sum -c - && \
    R CMD INSTALL /tmp/gsmoothr.tar.gz /tmp/Rsolnp.tar.gz /tmp/S7.tar.gz && \
    rm /tmp/gsmoothr.tar.gz /tmp/Rsolnp.tar.gz /tmp/S7.tar.gz && \
    Rscript -e 'BiocManager::install(c("Repitools", "GenomicFeatures", "NOISeq", "Rsamtools", "rtracklayer"), update=FALSE, ask=FALSE)' && \
    Rscript -e 'p <- c("optparse", "XML", "Repitools", "GenomicFeatures", "NOISeq", "Rsamtools", "rtracklayer"); missing <- p[!vapply(p, requireNamespace, logical(1), quietly=TRUE)]; if (length(missing)) stop("Missing R packages: ", paste(missing, collapse=", "))'

WORKDIR /opt2
# Install Qualimap
RUN wget -O qualimap_v2.2.1.zip https://mirror.spack.io/_source-cache/archive/08/08f1d66e49c83c76c56c4225c53aee44f41e0592c8bdc84b8c4ecd975700e045.zip && \
    echo "08f1d66e49c83c76c56c4225c53aee44f41e0592c8bdc84b8c4ecd975700e045  qualimap_v2.2.1.zip" | sha256sum -c - && \
    unzip qualimap_v2.2.1.zip && \
    rm -f qualimap_v2.2.1.zip
# Add QualiMap to PATH
ENV PATH="/opt2/qualimap_v2.2.1":$PATH

RUN qualimap --help

# Copy Dockerfile and other files in a single layer
COPY ${DOCKERFILE} /opt2/Dockerfile_${REPONAME}.${BUILD_TAG}
RUN chmod -R a+rx /opt2 && chmod a+r /opt2/Dockerfile_${REPONAME}.${BUILD_TAG}