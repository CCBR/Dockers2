FROM nciccbr/ccbr_ubuntu_22.04:v4

# Build time variables
ARG DOCKERFILE="Dockerfile"
ENV DOCKERFILE=${DOCKERFILE}
ARG BUILD_DATE="000000"
ENV BUILD_DATE=${BUILD_DATE}
ARG BUILD_TAG="000000"
ENV BUILD_TAG=${BUILD_TAG}
ARG REPONAME="000000"
ENV REPONAME=${REPONAME}
ARG IMAGENAME="000000"
ENV IMAGENAME=${IMAGENAME}
ARG BASEIMAGENAME="000000"
ENV BASEIMAGENAME=${BASEIMAGENAME}



WORKDIR /opt2
ENV DEBIAN_FRONTEND=noninteractive
ENV XENGSORT_VERSION=1.1.0


RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-setuptools python3-dev \
    build-essential pkg-config libhdf5-dev ca-certificates \
    curl wget unzip git && \
    rm -rf /var/lib/apt/lists/*

# --- Modern Python build toolchain ---
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# --- Pre-pin scientific stack to avoid ABI/version breakage ---
# numpy<2 keeps older numba wheels happy; h5py<3.13 avoids latest quirks
# (llvmlite will be solved to match numba)
RUN pip3 install --no-cache-dir "numpy<2" "numba<0.60" "h5py<3.13" "pandas<2.2"

# --- Install Xengsort 1.1.0 from GitLab tag (PyPI no longer has it) ---

RUN pip3 install --no-cache-dir \
    "git+https://gitlab.com/genomeinformatics/xengsort.git@1.1.0"

# --- Smoke test ---
RUN xengsort --help >/dev/null 2>&1 || python3 -c "import xengsort"

# --- Provenance ---
COPY ${DOCKERFILE} /opt2/Dockerfile_${REPONAME}.${BUILD_TAG}
RUN chmod -R a+rx /opt2 && chmod a+r /opt2/Dockerfile_${REPONAME}.${BUILD_TAG}


WORKDIR /opt2
ENV DEBIAN_FRONTEND=noninteractive
ENV XENGSORT_VERSION=1.1.0

# System build deps (h5py needs headers if wheel not available)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-setuptools python3-dev \
    build-essential pkg-config libhdf5-dev ca-certificates \
    curl wget unzip && \
    rm -rf /var/lib/apt/lists/*

# Modern build tooling
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Pre-pin scientific stack to avoid ABI/version breakage
# - numpy<2 to keep numba wheels happy
# - numba<0.60 to stay compatible with numpy<2 and older llvmlite
# - h5py<3.13 to avoid latest HDF5 quirks
RUN pip3 install --no-cache-dir "numpy<2" "numba<0.60" "h5py<3.13" "pandas<2.2"

# Install Xengsort 1.1.0
RUN pip3 install --no-cache-dir "xengsort==${XENGSORT_VERSION}"

# Smoke tests
RUN xengsort --help >/dev/null 2>&1 || (python3 -c "import xengsort" )

# provenance
ARG DOCKERFILE="Dockerfile" BUILD_TAG="000000" REPONAME="000000"
COPY ${DOCKERFILE} /opt2/Dockerfile_${REPONAME}.${BUILD_TAG}
RUN chmod -R a+rx /opt2 && chmod a+r /opt2/Dockerfile_${REPONAME}.${BUILD_TAG}


# Copy Dockerfile 
COPY ${DOCKERFILE} /opt2/Dockerfile_${REPONAME}.${BUILD_TAG}
RUN chmod -R a+rx /opt2 && chmod a+r /opt2/Dockerfile_${REPONAME}.${BUILD_TAG}